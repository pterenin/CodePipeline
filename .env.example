PORT=3000
LOG_LEVEL=info

JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=automation@example.com
JIRA_API_TOKEN=your-jira-api-token

# Choose either a full JQL query or the simpler project/label/status queue settings below.
# JIRA_JQL=project = ENG AND labels = ai-ready AND status = "Ready for Automation" ORDER BY priority DESC, created ASC
JIRA_PROJECT_KEY=ENG
JIRA_QUEUE_LABEL=ai-ready
JIRA_QUEUE_STATUS=Ready for Automation
JIRA_FORCE_INCLUDE_KEYS=
JIRA_DONE_LABEL=ai-done
JIRA_REVIEW_TRANSITION_NAME=In Review
JIRA_COMMENT_PREFIX=AI Agent:

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=your-github-token
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

GIT_REMOTE_URL=git@github.com:your-org/your-repo.git
GIT_BASE_BRANCH=main
GIT_DIRECT_COMMITS=false

WORK_ROOT=./workdir

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4
CODEX_CLI_PATH=codex
# Optional Codex profile to use for non-interactive runs when your MCP/tool setup lives in a named profile.
CODEX_PROFILE=
# When true, Codex is instructed to use the Atlassian MCP server for live Jira reads when available.
CODEX_USE_ATLASSIAN_MCP=true
GUARDRAIL_HARD_BLOCKED_KEYWORDS=api key,secret,private key,token rotation,database migration,schema migration,data backfill,infrastructure migration,terraform,kubernetes,helm
GUARDRAIL_SCAN_HUMAN_COMMENTS=false
GUARDRAIL_WEAK_REQUIREMENT_THRESHOLD=20
BYPASS_CONFIRMATION_REVIEW_FOLLOW_UP=false
VALIDATION_COMMANDS=["npm ci","npm run lint","npm run build","npm run test"]
VALIDATION_REPAIR_ATTEMPTS=5
DRY_RUN_BY_DEFAULT=false
VISUAL_REVIEW_ENABLED=true
VISUAL_REVIEW_TIMEOUT_MS=120000
VISUAL_REVIEW_STARTUP_TIMEOUT_MS=120000
# Path to a Playwright storage-state file created by `npm run visual:login`.
# Required when a visual review target sets "authenticated": true in its plan.
VISUAL_REVIEW_STORAGE_STATE=.visual-review/storage-state.json
# Login page URL used by `npm run visual:login` to bootstrap the storage state.
# VISUAL_REVIEW_LOGIN_URL=https://dashboard.example.invalid/login
