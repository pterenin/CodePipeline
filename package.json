{
  "name": "jira-ai-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Production-minded Node.js + TypeScript service that turns Jira tickets into draft GitHub PRs with AI assistance.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "openai": "^6.33.0",
    "simple-git": "^3.33.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
