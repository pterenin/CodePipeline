{
  "name": "codepipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Jira-to-GitHub AI worker that prepares isolated worktrees, runs Codex CLI, and opens draft pull requests.",
  "license": "MIT",
  "homepage": "https://github.com/pterenin/CodePipeline#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pterenin/CodePipeline.git"
  },
  "bugs": {
    "url": "https://github.com/pterenin/CodePipeline/issues"
  },
  "keywords": [
    "jira",
    "github",
    "automation",
    "codex",
    "ai-agent",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "openai": "^6.33.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "simple-git": "^3.33.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
